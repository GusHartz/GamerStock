# Copy this file to .env and fill in the real values.
# .env is gitignored. NEVER commit secrets.

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev (via docker-compose):
#   postgresql://gamerstock:gamerstock_dev_pw@localhost:5433/gamerstock_dev
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5433/DBNAME

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Session ──────────────────────────────────────────────────────────────────
# REQUIRED. Generate a random string of 64+ characters.
SESSION_SECRET=replace-with-a-long-random-string

# ─── Admin ────────────────────────────────────────────────────────────────────
# REQUIRED. No fallback in code.
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-password-min-12-chars
ADMIN_BOOTSTRAP_EMAIL=admin@your-domain.example
ADMIN_BOOTSTRAP_SECRET=replace-with-a-different-random-string

# ─── External APIs (optional) ─────────────────────────────────────────────────
# RIOT_API_KEY=
# STEAM_WEB_API_KEY=
# PANDASCORE_API_KEY=

# ─── Replit-only (leave empty on local) ───────────────────────────────────────
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc

# ─── Feature flags ────────────────────────────────────────────────────────────
PREDICT_ENABLED=true
VITE_PREDICT_ENABLED=true

# ─── Bots / simulation ────────────────────────────────────────────────────────
# DISABLE_BOTS=false
# ENABLE_BOTS=false

# ─── Ingestion scheduler (optional tuning) ────────────────────────────────────
# INGESTION_SCHEDULER_ENABLED=true
# INGESTION_SCHEDULER_INTERVAL_MS=900000
# INGESTION_DEFAULT_GAMES=lol,cs2,dota2

# ─── Debug ────────────────────────────────────────────────────────────────────
# EVENTS_DEBUG=false
